# Copy to .env and adjust. .env is gitignored; this file is not.

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memo_dev
POSTGRES_TEST_DB=memo_test

# --- Application ---
# "test" unregisters the test-only reset route. See docs/adr/0001.
ENV=dev
# At least 32 bytes: PyJWT warns about HMAC-SHA256 keys shorter than that.
SECRET_KEY=dev-only-placeholder-not-a-real-secret-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
